GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173
# Gemini digests are paused while the severity model is unvalidated
DIGEST_GENERATION_ENABLED=false
# Bearer token for POST /api/pipeline/trigger and /api/internal/*; leave unset to disable them
PIPELINE_TRIGGER_TOKEN=
# Stale open events looked up by ID per pipeline run (0 disables the lookups)
STALE_LOOKUP_LIMIT=5
